# Copy to .env (git-ignored) and fill in. Generate random values with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# Public hostname; DNS must point at the server before the first start
# so Traefik can get the Let's Encrypt certificate.
FINANCE_HOST=finance.example.com

# Signs login sessions. Random, and keep it stable (changing it logs everyone out).
SECRET_KEY=

APP_TIMEZONE=Europe/Ljubljana

# The only people who can log in to the portal (comma-separated). There is no
# sign-up and no password: the login page emails a one-time code to these addresses.
PORTAL_USERS=Ana Novak <ana@example.com>, Ben Novak <ben@example.com>

# Outgoing mail for login codes: SMTPS, implicit TLS on port 465.
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_USERNAME=finance@example.com
SMTP_PASSWORD=
MAIL_FROM=Finance <finance@example.com>

# From @BotFather.
TELEGRAM_BOT_TOKEN=
# The secret part of the webhook URL: https://FINANCE_HOST/telegram/<this>
TELEGRAM_WEBHOOK_PATH=
# Telegram sends this back in a header on every update; requests without it are refused.
# Letters, digits, _ and - only, up to 256 characters.
TELEGRAM_WEBHOOK_SECRET=
# Your Telegram user id: gets error reports and may use the bot from any chat.
TELEGRAM_ADMIN_ID=
# Chats and people allowed to use the bot, comma-separated. Add your group's
# chat id (a negative number); the bot replies with it if it is missing.
TELEGRAM_ALLOWED_IDS=

# Interactive Brokers holdings (read-only Flex Web Service). In Client Portal:
# Performance & Reports > Flex Queries > Activity Flex Query with Account Information,
# Net Asset Value (NAV) in Base, Open Positions, Cash Report (+ Conversion Rates),
# format XML, period Last Business Day. Then Flex Web Service > generate a token
# (up to 1 year, restrict it to the server's IP). Leave empty to hide the sync.
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=

# Optional: a different household settings file (default: app/household.json,
# falling back to app/household.example.json).
HOUSEHOLD_FILE=

# ── Renovation planner (optional) ────────────────────────────────────────────
# A second app beside finance: big items with deadlines, the work under them as
# a Gantt chart, and its payments over the finance forecast. To run it, uncomment:
#COMPOSE_PROFILES=renovation
RENOVATION_HOST=renovation.example.com
# Its own random value, different from SECRET_KEY.
RENOVATION_SECRET_KEY=
# Who can log in; empty means the same people as PORTAL_USERS. Login codes go
# out through the SMTP settings above.
RENOVATION_USERS=
# Shared by both apps: finance answers /api/v1 only with this token. Random.
FINANCE_API_TOKEN=
# The finance category house spending is logged under (it must exist there,
# e.g. hisa). Payments recorded in the planner are logged in finance under it.
# Empty: payments stay in the planner only.
RENOVATION_FINANCE_CATEGORY=
# When everyone who can log in gets the "ready to start" email (APP_TIMEZONE),
# comma-separated. Empty: never.
RENOVATION_DIGEST=mon 08:00, fri 18:00

# ── Traefik (optional) ───────────────────────────────────────────────────────
# Defaults are spaceshuttle's; set these only on a host whose Traefik differs
# (e.g. a restore on rokv-serv: TRAEFIK_NETWORK=webwatchdog_edge, TRAEFIK_CERTRESOLVER=le).
#TRAEFIK_NETWORK=nginx-proxy
#TRAEFIK_CERTRESOLVER=letsencrypt
#TRAEFIK_ENTRYPOINT_HTTPS=websecure
#TRAEFIK_ENTRYPOINT_HTTP=web

# ── Restored copy (RESTORE.md) ───────────────────────────────────────────────
# 1 only on a copy restored from a backup: both apps run, show a RESTORE COPY
# banner, and contact nothing outside: no Telegram (messages, alerts, webhook),
# no IBKR sync, no bill reminders, no digest email. Always 0 in production.
RESTORE_MODE=0
# With RESTORE_MODE=1, all mail (login codes) goes to this one address instead.
# Empty: mail is not sent, only written to the log (docker compose logs finance).
RESTORE_MAIL_TO=
